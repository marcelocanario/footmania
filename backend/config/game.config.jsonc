{
  // League structure. Total match days = turns * (teams - 1).
  "league": {
    // Number of clubs in the league (also the number generated for the world).
    // (e.g. 8 = 8 clubs; with 2 turns that is 14 rounds per season.)
    "teams": 8,
    // Number of times each pair of teams meets (2 = home and away).
    "turns": 2,
    // Day of the season (0-indexed) on which the first league round is played.
    // (e.g. 1 = the first round is played on the day after the season starts.)
    "startDay": 1,
    // Full game-days with no league match between consecutive rounds.
    "restDaysBetweenMatches": 1
  },

  // --- Discipline ---
  // Post-match consequences of card events. Purely downstream of the match
  // engine: nothing here feeds back into match simulation probabilities.
  "discipline": {
    // Yellow cards accumulated within one league turn that trigger an
    // automatic ban. The counter resets at every league-turn boundary.
    // (e.g. 2 = a second booking inside the same half-season bans the player.)
    "turnYellowLimit": 2,
    // Length in club fixtures of the automatic yellow-accumulation ban.
    "turnYellowBanGames": 1,
    // Red-card tribunal: games = round(base + lnCoefficient * ln(X)) where X
    // is a uniform integer 1..100 drawn from the world RNG.
    // Defaults yield 59% x1, 27% x2, 9% x3, 4% x4, 1% x5 matches.
    "tribunalBase": 5.1748,
    "tribunalLnCoefficient": -0.9884
  },

  // Guaranteed full game-days after the final league round and before the
  // following season begins. The inter-season gap is the sum of these two
  // windows; the derived season length is 35 days.
  "interseasonAfterMatchDays": 2,
  "interseasonBeforeNextSeasonDays": 5,

  // --- Scheduler (wall-clock) ---
  "scheduler": {
    // UTC time at which one game-day ends and the next begins. All day-based
    // cadences (payroll, weekly sim, rest days, season boundaries) advance
    // when this instant is crossed.
    // (e.g. "00:00" = a new game-day starts at midnight UTC.)
    "gameDayRolloverUtc": "00:00",
    // Lease duration in real seconds for the global mutation lock and due-event
    // claims. A crashed holder's lease expires after this window so work can be
    // retried; stale entries are reclaimed after twice this duration.
    // (e.g. 30 = a held lock expires 30 seconds after its last heartbeat.)
    "leaseSeconds": 30
  },

  // --- Multiplayer ---
  // Fraction of rounds after which no new humans may join the current season.
  // (e.g. 0.5 = after half the season's rounds are complete, new clubs are
  // queued as PROVISIONAL for the next season.)
  "joinThresholdPercent": 0.5,

  "economy": {
    // Existing seasonal money flows were calibrated against 30 game-days.
    "referenceSeasonDays": 30
  },

  // Game-day cadence at which player wages are paid. Wages are prorated over
  // the derived season length so a full season sums to the stored annual salary.
  // (e.g. 7 = wages are paid every 7 game-days.)
  "payrollIntervalDays": 7,
  // Game-day cadence for weekly simulation updates (potential growth and
  // contracts). Energy recovery is now processed every game day.
  // (e.g. 7 = a weekly sim update runs every 7 game-days.)
  "weeklyIntervalDays": 7,
  // Real-time days an unclaimed free agent remains available across relists.
  // After this the listing is deleted for good — a genuine population sink that
  // the seasonal academy intake must compensate for.
  "freeAgentRetentionDays": 30,
  // Derivation inputs for the TARGET free-agent stock. The normal free-agent
  // pool is part of the population target, not an untracked surplus on top of a
  // club-only target, so it has to be derived from real flow: how many contracts
  // expire, how often those players are signed, and how long the rest linger.
  // All three are calibration outputs measured from full-world simulation.
  "freeAgentPool": {
    // Contracts expiring per active club per season.
    "expectedExpiriesPerActiveClubPerSeason": 4,
    // Probability an expired player is signed before his retention runs out.
    "signingProbability": 0.6,
    // Seasons a player who IS signed spends in the pool before leaving it.
    "signedResidenceSeasons": 0.1
  },
  // How many seasons before a contract's expiry (in game-days) a club starts
  // trying to renew the player.
  // (e.g. 2 = renewal talks begin 2 seasons before expiry.)
  "contractWarningSeasons": 2,

  // --- Player economy ---
  //
  // Player market value = base x (overall/reference)^exponent x ageMultiplier
  //                       x contractMultiplier x multiplier
  // Value is fully deterministic for a given overall / age / contract and never
  // depends on hidden development, form, position, or club.
  //
  // Base monetary unit used to scale the whole value curve. Doubling it roughly
  // doubles every player's market value.
  // (e.g. raising 500000 to 1,000,000 roughly doubles every player's value.)
  "playerValueBase": 500000,
  // The overall rating that produces a value multiplier of exactly 1.0 before
  // age/contract are applied. Players rated above this get super-linear value;
  // below it get sub-linear value.
  // (e.g. 50 = a rating of 50 yields a value multiplier of 1.0.)
  "playerValueOverallReference": 50,
  // Exponent applied to (overall / reference). Higher exponents make high-rated
  // players disproportionately more expensive (super-linear growth).
  // (e.g. 3.5 = a rating of 75 is worth ~4.1x a rating of 50.)
  "playerValueOverallExponent": 3.5,
  // Global multiplier applied to the final value. A convenient single knob to
  // scale all market values without touching the base or curves.
  // (e.g. 1.5 = every player's market value rises by 50%.)
  "playerValueMultiplier": 1,
  // Age multiplier applied to base value (ages between keyframes interpolate).
  // Below ~23 the multiplier grows with age (prospects appreciate), peaks in
  // the mid-20s, then declines sharply past 30 as players depreciate.
  "playerValueAgeCurve": {
    "16": 0.65, "17": 0.72, "18": 0.8, "19": 0.88, "20": 0.95, "21": 1.03, "22": 1.1, "23": 1.14,
    "24": 1.15, "25": 1.15, "26": 1.15, "27": 1.12, "28": 1.05, "29": 0.97, "30": 0.9, "31": 0.8,
    "32": 0.7, "33": 0.6, "34": 0.5, "35": 0.4, "36": 0.3, "37": 0.22, "38": 0.15, "39": 0.1, "40": 0.08
  },
  // Contract length (in seasons) at which the contract multiplier is exactly
  // 1.0. Shorter contracts are worth slightly less; longer ones slightly more.
  // (e.g. 3 = a 3-season contract leaves value unchanged.)
  "playerValueContractNeutralSeasons": 3,
  // How much the value multiplier changes per season of difference from
  // contractNeutralSeasons (e.g. 0.05 = 5% per season).
  "playerValueContractWeight": 0.05,
  // Lower bound for the contract multiplier (floor applied when contracts are
  // very short). Prevents value from dropping too far on expiring contracts.
  // (e.g. 0.9 = value never falls below 90% of its neutral-contract level.)
  "playerValueContractMinMultiplier": 0.9,
  // Upper bound for the contract multiplier (cap applied when contracts are
  // very long). Prevents value from inflating too much on long contracts.
  // (e.g. 1.1 = value never rises above 110% of its neutral-contract level.)
  "playerValueContractMaxMultiplier": 1.1,

  // Base salary = salaryBase x (overall/reference)^exponent x ageMultiplier x multiplier.
  // Used only when a contract is first established; persisted salaries are fixed.
  //
  // Base monetary unit for the salary curve. Doubling it roughly doubles every
  // player's suggested salary.
  // (e.g. 70000 = a rating-50 player at neutral age is offered ~70000/season.)
  "salaryBase": 70000,
  // The overall rating that produces a salary multiplier of exactly 1.0 before
  // age is applied.
  // (e.g. 50 = a rating of 50 yields a salary multiplier of 1.0.)
  "salaryOverallReference": 50,
  // Exponent applied to (overall / reference). Higher values make top players
  // demand disproportionately higher wages.
  // (e.g. 2.5 = a rating of 75 demands ~2.8x a rating of 50.)
  "salaryOverallExponent": 2.5,
  // Global multiplier applied to the final suggested salary. A convenient knob
  // to scale all wages without touching the base or curves.
  // (e.g. 1.5 = every suggested salary rises by 50%.)
  "salaryMultiplier": 1,
  // Age multiplier applied to the suggested salary (ages between keyframes
  // interpolate). Young prospects earn less, peak in their mid-to-late 20s,
  // then decline after ~30 as players age.
  "salaryAgeCurve": {
    "16": 0.5, "17": 0.6, "18": 0.7, "19": 0.8, "20": 0.9, "21": 1, "22": 1.05, "23": 1.1,
    "24": 1.1, "25": 1.1, "26": 1.1, "27": 1.1, "28": 1.05, "29": 1, "30": 0.95, "31": 0.9,
    "32": 0.85, "33": 0.8, "34": 0.75, "35": 0.7, "36": 0.65, "37": 0.6, "38": 0.55, "39": 0.5, "40": 0.45
  },
  // Minimum salary a player can ever receive (per season). Guards against
  // absurdly low wages for very low-rated or very old players.
  // (e.g. 500 = no annual salary can fall below 500.)
  "salaryFloor": 500,
  // Academy players receive this fraction of the salary the SAME player would
  // receive from the complete professional-contract calculation for his current
  // OVR, age, exact term, and season fraction. Must be strictly between 0 and 1;
  // no professional floor is reapplied afterwards, so the configured fraction
  // is exact. The resulting low release clause is a deliberate mobility
  // mechanism for promoted academy players.
  // (e.g. 0.1 = an academy player earns 10% of his professional-equivalent wage.)
  "academySalaryMultiplier": 0.1,

  // --- Contracts & renewals ---
  //
  // Maximum contract length (in seasons) a player can be offered. Both the API
  // validation and the frontend renewal dropdown honor this value.
  // (e.g. 5 = no player can be offered more than 5 seasons.)
  "maxContractSeasons": 5,
  // Minimum fractional raise a player expects per season of a new contract,
  // regardless of how good he is (e.g. 0.02 = at least a 2% raise).
  "renewalMinRaise": 0.02,
  // How strongly a player's skill (overall) influences the raise he demands.
  // Higher values make top players ask for much bigger raises than squad players.
  // (e.g. 0.08 = full skill adds up to 8 percentage points to the raise.)
  "renewalSkillRaiseWeight": 0.08,
  // Exponent applied to the normalized skill before weighting the raise. Values
  // > 1 make the skill influence super-linear (only elite players get big raises).
  // (e.g. 1.6 = half-skill counts as ~0.33 instead of 0.5.)
  "renewalSkillExponent": 1.6,
  // Maximum fractional raise a player can demand per season, capping renewal
  // demands even for the best players at their peak.
  // (e.g. 0.15 = no renewal demand exceeds a 15% raise per season.)
  "renewalMaxRaise": 0.15,
  // Extra annual demand a young developing player adds on top of the minimum
  // and skill components. This is what makes locking a promising youngster into
  // a long deal expensive without erasing the advantage of promoting him.
  // (e.g. 0.05 = a peak-curve young player adds up to 5 percentage points.)
  "renewalYouthPremiumWeight": 0.05,
  // Visible-age curve for that premium. It peaks for young developing players
  // and fades to zero through the mid-20s. It MUST stay a function of visible
  // age only: reading hidden growth potential here would leak scouting
  // information into a public salary quote.
  "renewalYouthPremiumAgeCurve": {
    "16": 0.9, "17": 1, "18": 1, "19": 0.95, "20": 0.85, "21": 0.7, "22": 0.55, "23": 0.4,
    "24": 0.25, "25": 0.12, "26": 0.05, "27": 0
  },
  // Release clause = salaryPerSeason x remainingSeasons x this percentage.
  // Fraction of the remaining contract value (salary x seasons left) the club
  // must pay to release the player early.
  // (e.g. 0.5 = releasing a player costs 50% of his remaining contract value.)
  "releaseClauseRemainingValuePct": 0.5,

  // --- Player generation ---
  //
  // Career-shaped quality model. Generation draws the player's hidden career
  // profile FIRST, anchors his personal career peak on his division, then
  // reconstructs the OVR he should already have at his generated age. A
  // generated 18-year-old therefore looks like someone who has already lived
  // part of the development curve, not like a 28-year-old drawn at 18.
  "playerGeneration": {
    // Mean OVR of the COMPLETE generated Division 1 senior population across
    // all ages — not the mean of the selected XI. Best-XI selection lifts the
    // automatic lineup well above this figure.
    "topDivisionMeanOverall": 74,
    // Standard deviation of individual senior career quality, in OVR points.
    "playerQualitySpreadOverall": 5.5,
    // Wider spread for academy career quality. The extra tail is what keeps
    // rare wonderkids possible without widening every senior squad.
    "academyQualitySpreadOverall": 6,
    // Total mean OVR difference from Division 1 to the current bottom division.
    // This stays fixed as divisions are added; the division curve redistributes
    // the intermediate means across the larger pyramid.
    "divisionOverallSpan": 18,
    // How far a player's personal career PEAK sits above his division's all-age
    // population mean. Calibrated so the age mix of a standing population
    // averages back down to topDivisionMeanOverall.
    "seniorPeakOverallOffset": 6.7,
    // Maximum shift a perfect academy pedigree applies to the academy career
    // PEAK anchor (never to current OVR directly). Setting this equal to
    // divisionOverallSpan means a stable D1 academy has the same normal peak
    // anchor as D1 seniors.
    "academyPedigreeOverallBoost": 18,
    // Pedigree weights, normalized by the shared helper. Highest-ever division
    // is a permanent ratchet: once a club has reached D1, its historical
    // component keeps using D1 strength forever.
    "academyCurrentDivisionWeight": 0.65,
    "academyHighestEverDivisionWeight": 0.35
  },

  // --- Career growth and decline ---
  //
  // A career is described by five hidden values: growth potential and speed,
  // an exact peak age, and decline potential and speed. POTENTIAL sets total
  // magnitude; SPEED only changes timing and steepness. There is deliberately
  // no second potential ceiling, growth tier, or development-rate multiplier —
  // any of those would let growth be granted twice.
  "playerCareer": {
    // OVR-equivalent growth a player with growthPotential = 1 realizes across
    // his whole pre-peak career at full activity.
    "maximumCareerGrowthOverall": 30,
    // OVR-equivalent decline a player with declinePotential = 1 suffers across
    // his whole post-peak career at neutral activity.
    "maximumCareerDeclineOverall": 26,
    // Piecewise-linear probability densities over the continuous 0-to-1 range,
    // as [value, density] points. Density need not integrate to one; it is
    // normalized. Sampling is exact inverse-CDF, so the realized distribution
    // matches these points rather than approximating them.
    "growthPotentialDistribution": [[0, 0.35], [0.3, 0.85], [0.6, 1.6], [0.85, 1.25], [1, 0.5]],
    "growthSpeedDistribution": [[0, 0.5], [0.5, 1.5], [1, 0.5]],
    "declinePotentialDistribution": [[0, 0.45], [0.4, 1.4], [0.7, 1.2], [1, 0.6]],
    "declineSpeedDistribution": [[0, 0.6], [0.5, 1.4], [1, 0.6]],
    // Slow/fast cumulative GROWTH boundary curves as [progress, fraction]
    // points, where progress runs from 0 at academy entry age to 1 at the
    // player's own peak age. Both must start at 0 and terminate at 1 so speed
    // never changes the full-activity growth total, and fast may never fall
    // behind slow at any comparable point.
    "growthSlowCurve": [[0, 0], [0.25, 0.14], [0.5, 0.36], [0.75, 0.66], [1, 1]],
    "growthFastCurve": [[0, 0], [0.25, 0.44], [0.5, 0.72], [0.75, 0.9], [1, 1]],
    // Truncated-normal personal peak age, drawn as an integer. Most peaks land
    // near the mean with real tails on both sides.
    "peakAgeDistribution": { "mean": 27, "stdDev": 2.4, "min": 23, "max": 33 },
    // Slow/fast cumulative DECLINE boundary curves as [yearsSincePeak,
    // fraction] points. Same monotonic 0-to-1 and fast >= slow rules apply.
    "declineSlowCurve": [[0, 0], [2, 0.08], [4, 0.2], [6, 0.36], [8, 0.55], [10, 0.75], [12, 0.9], [14, 1]],
    "declineFastCurve": [[0, 0], [2, 0.2], [4, 0.42], [6, 0.62], [8, 0.78], [10, 0.9], [12, 0.97], [14, 1]],
    // Activity a generated player is assumed to have had historically. Lower
    // values reduce his REALIZED growth; they never move him closer to his peak.
    "generationHistoricalActivity": 0.7,
    // Annual probability that a player of this age leaves the active population
    // for the non-retirement structural reason: his contract expires, no club
    // signs him, and he is deleted when the free-agent retention period ends.
    // This depends on manager behavior, so it is a calibration input measured
    // from full-world simulation, not a derived constant. Transfers, loans, and
    // dormancy are NOT drains — they only change ownership or the boundary.
    "freeAgentTerminalLossAgeCurve": {
      "20": 0.01, "24": 0.015, "28": 0.02, "31": 0.05, "34": 0.1, "37": 0.2, "40": 0.35
    }
  },

  // --- Structural academy/squad rules ---
  "playerGenerationRules": {
    // Fixed senior squad size for a newly created club.
    "initialSeniorSquadSize": 30,
    // Youth players generated for a newly created club.
    "initialAcademySize": 11,
    // Maximum youth roster size; unused seasonal intake slots are lost.
    "academyRosterLimit": 15,
    // Academy age range for generation. No intake path ever generates an
    // age-20 youth player: everyone is promoted no later than that boundary.
    "academyMinAge": 16,
    "academyMaxAge": 19,
    // Earliest age a manager may VOLUNTARILY promote a youth player.
    "academyVoluntaryPromotionAge": 18,
    // Age at which every remaining academy player is promoted automatically.
    // Mandatory and atomic: it may create a temporary senior-roster overflow
    // rather than releasing or replacing anyone.
    "academyAutomaticPromotionAge": 20,
    // Age at which an academy-origin contract expires. Academy contract terms
    // are DERIVED as (academyContractEndAge - currentAge); there is no fixed
    // configured academy contract length.
    "academyContractEndAge": 21,
    // Target owned players (senior + academy) per active persistent club. This
    // is the population-control target, distinct from the enforced roster caps.
    "targetOwnedPlayersPerActiveClub": 38,
    // Guaranteed new prospects per active club every season, even during a
    // population surplus. Must be greater than zero.
    "minimumAcademyIntakePerActiveClub": 1,
    // Probability that a newly generated player is from a country other than
    // the club's country. The selected country also supplies the player's name.
    // (e.g. 0.05 = 5% foreign-born players.)
    "foreignPlayerChance": 0.05
  },

  // --- Match simulator influence (plans/6. match-simulator-overhaul.md §6) ---
  // Primary balance tunables: the normalized 40/35/25 latent decision weights.
  // The full matchSimulator model lives in config/match-simulator.jsonc; only
  // these weights are promoted here so designers tune competitive balance in
  // one place (plan section 0).
  "matchSimulator": {
    "influence": {
      "team": 0.4,
      "tactics": 0.35,
      "luck": 0.25
    }
  },

  // --- Live match pacing (wall-clock) ---
  // Real minutes a live league match takes to play out (authoritative server
  // pacing; clients derive tick delay from this). Halftime pause is real time
  // shown only when a human team is involved; AI vs AI and instant sims skip it.
  // tacticsCooldownMatchMinutes locks style/pressing/direction changes per side
  // after each change (manual or automation), in match-minutes.
  "liveMatch": {
    "matchDurationMinutes": 30,
    "halftimePauseMinutes": 5,
    "tacticsCooldownMatchMinutes": 10,
    // Maximum substitutions per side per match (manual, automation and the
    // engine's injury auto-substitution all draw from this shared cap).
    "maxSubsPerSide": 5,
    // Real minutes before a scheduled kickoff that the pre-game prep screen
    // (lineup + tactics) opens for the two human clubs. 0 disables the window.
    "pregameWindowMinutes": 60
  },

  "energy": {
    "matchLossScale": 1.0,
    "recoveryScale": 1.0
  },

  "injuries": {
    "matchTargetPerMatch": 0.9,
    "trainingTargetPerClubSeason": 1.5,
    "severityScale": 1.0,
    // Auto-replace a player removed by a match injury with the best
    // same-position bench player, consuming one of the side's substitution
    // slots. Without slots or an eligible candidate the team plays short.
    "autoSubstitute": true
  },

  // --- Admin message of the day ---
  // Single pinned announcement shown at the top of every user's News feed.
  "motd": {
    "maxLength": 280
  },

  // --- Season awards ---
  // A player must have played at least this share of his club's league games
  // in the season (at least one minute on the pitch per match) to win an
  // individual award or make the division's Best XI.
  "awards": {
    "minAppearanceFraction": 0.4
  }
}
