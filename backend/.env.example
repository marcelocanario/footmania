DATABASE_URL="postgresql://footmania_dev:<password>@192.168.0.35:5432/footmania?schema=development"
# Connection pool sizing for the single-process server: default is
# num_cpus * 2 + 1; cap it for predictable resource use, e.g.
# DATABASE_URL="postgresql://.../footmania?schema=development&connection_limit=10"
TEST_DATABASE_URL="postgresql://footmania_dev:<password>@192.168.0.35:5432/footmania?schema=test"
PORT=3001
SESSION_TTL_DAYS=30

# better-auth secret. Signs/encrypts session cookies and OAuth state. Required
# in production; dev/test fall back to a source default if unset. Generate one
# with `npx auth secret` or `openssl rand -base64 32`.
BETTER_AUTH_SECRET="PLACEHOLDER_YOUR_BETTER_AUTH_SECRET"

# Google OAuth (better-auth). Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials and set the authorized
# redirect URI to <PUBLIC_ORIGIN>/api/auth/callback/google.
GOOGLE_CLIENT_ID="PLACEHOLDER_YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="PLACEHOLDER_YOUR_GOOGLE_CLIENT_SECRET"

# Public origin of the web app. The frontend dev server runs on :3000 (see
# frontend/vite.config.ts) and Google is configured with this origin, so keep
# it in sync if you change the frontend port or deploy somewhere else.
PUBLIC_ORIGIN="http://localhost:3000"

# The Google account (verified email) granted admin rights at every sign-in.
# Optional: when unset, no one is admin and the admin panel is unreachable.
ADMIN_EMAIL="PLACEHOLDER_ADMIN_EMAIL"
