{
  "name": "footmania-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-game-data.mjs",
    "start": "tsx dist/src/server.js",
    "test": "vitest run",
    "test:calibration": "vitest run --config vitest.calibration.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration && npm run test:calibration",
    "test:watch": "vitest",
    "calibrate:match": "tsx scripts/match-calibration-next.ts",
    "regenerate:match-golden": "tsx scripts/regenerate-match-golden.mts",
    "db:generate": "prisma generate",
    "db:upgrade": "node scripts/db-upgrade.mjs",
    "db:push": "prisma db push",
    "db:migrate-contract-market": "tsx scripts/migrate-contract-market.ts",
    "db:reset": "prisma migrate reset",
    "db:seed-name-pools": "tsx scripts/import-name-pools.mts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.1",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.5",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.7.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.5",
    "@types/ws": "^8.18.1",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true
  }
}
