generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  timezone     String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  sessions     Session[]
  saves        Save[]
  club         Club?    @relation("ClubOwner")
}

model Session {
  token     String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// A save is fully normalized: every world entity lives in its own table.
// The in-memory `World` object stays the engine's source of truth; persistence
// is a full sync (delete + insert) inside the save lock, and loading rebuilds
// the World from the tables. `LiveMatch` is the documented exception: transient
// runtime state kept as JSON because it is never queried relationally.
// `worldJson` is retained only as a one-release compatibility bridge for saves
// created by the pre-normalized schema.
model Save {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  year        Int
  dayIndex    Int
  humanClubId Int?
  seed        Int      @default(0)
  rngState    BigInt   @default(0)
  // Multiplayer: exactly one global Save row exists (isGlobal = true). It holds
  // the shared world all users play in. Regular per-user saves are retired.
  isGlobal    Boolean  @default(false)
  // Nullable so legacy per-user saves can coexist; GLOBAL is reserved for the
  // singleton multiplayer world and is database-unique.
  globalKey   String?  @unique
  worldJson   String?
  // Optimistic concurrency: bumped on every persist; conditional updates use
  // it to detect lost updates when multiple processes write the global world.
  revision    Int      @default(0)
  // Multiplayer runtime state (current season id, join state, etc.) persisted
  // as JSON so it survives reloads. Mirrors World.mp.
  mpStateJson String?
  seasonSummaryJson  String?
  // Final standings snapshots for completed seasons (plan §70). JSON because
  // history is write-once and never queried relationally.
  seasonHistoryJson String?
  pendingEventsJson  String?
  pendingMatchIdsJson String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clubs          Club[]
  players        Player[]
  loans          Loan[]
  competitions   Competition[]
  standingsRows  StandingsRow[]
  fixtures       Fixture[]
  matches        Match[]
  matchStats     MatchStat[]
  matchEvents    MatchEvent[]
  newsItems      NewsItem[]
  ledgerEntries  LedgerEntry[]
  auctions       Auction[]
  auctionBids    AuctionBid[]
  trophies       Trophy[]
  managerHistory ManagerHistory[]
  seasonAwards   SeasonAward[]
  records        CareerRecord[]
  ticketPrices   ClubTicketPrices[]
  stadiumUpgrades StadiumUpgrade[]
  tvDeals        TvDeal[]
  liveMatches    LiveMatch[]
  dailyExecutions DailyExecution[]
}

model Club {
  id               Int
  saveId           Int
  save             Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  // Multiplayer: the user who owns this club, null for filler AI clubs.
  ownerUserId      Int?   @unique
  ownerUser        User?  @relation("ClubOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Multiplayer: IANA timezone of the owner (clustering target).
  timezone         String?
  // Multiplayer: NEW | PROVISIONAL | ACTIVE | DORMANT
  competitionState String @default("ACTIVE")
  // Multiplayer: epoch ms of the last meaningful activity.
  lastMeaningfulActivityAt BigInt?
  // Multiplayer: epoch ms when the club became abandonment-eligible (inactivity
  // threshold exceeded). Removal only happens at season rollover.
  abandonmentEligibleAt BigInt?
  inactivityWarningStage Int @default(0)
  // Multiplayer: real timestamp (epoch ms) of the human's live league match
  // kickoff. Null when the club has no upcoming live match. Once the scheduled
  // kickoff passes, the match auto-plays to completion.
  liveMatchAt      BigInt?
  name             String
  shortName        String
  country          String
  level            Int
  cash             Int
  stadiumName      String
  stadiumCapacity  Int
  primaryColor     String
  secondaryColor   String
  coachName        String
  boardConfidence  Int
  fanConfidence    Int
  isHuman          Boolean
  captainId        Int?
  penaltyTakerId   Int?
  tacticsFormation Int
  tacticsStyle     Int
  tacticsPressing  Int
  tacticsDirection Int
  trainingFocus   String @default("assistant")
  savedLineupJson  String?

  @@id([saveId, id])
  @@index([saveId])
  @@index([saveId, ownerUserId])
  @@unique([saveId, ownerUserId])
}

model Player {
  id              Int
  saveId          Int
  save            Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId          Int?
  name            String
  country         String
  age             Int
  position        Int
  side            Int
  overall         Int
  potential       Int
  tier            Int
  characteristic1 Int
  characteristic2 Int
  energy          Int
  salary          Int
  payrollPaidThroughDay Int @default(0)
  payrollPaidAmount Int @default(0)
  payrollPeriodStartDay Int @default(0)
  value           Int
  releaseClause   Int
  injuryDays      Int
  contractDays    Int
  isYouth         Boolean
  starter         Boolean
  growthAcc       Float
  potentialAcc    Float
  careerGoals     Int
  careerAssists   Int
  seasonGoals     Int
  seasonAssists   Int
  yellows         Int
  reds            Int
  tacPos          Int
  onSale          Boolean
  salePrice       Int?
  suspendedGames  Int
  morale          Int
  loanId          Int?
  skillGol        Int
  skillVel        Int
  skillTec        Int
  skillPas        Int
  skillDes        Int
  skillArm        Int
  skillFin        Int
  skillAccJson    String
  declineStartAge Float?
  developmentRate Float?
  developmentVolatility Float?
  recentMinutesJson String?

  @@id([saveId, id])
  @@index([saveId, clubId])
}

model Loan {
  id         Int
  saveId     Int
  save       Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  playerId   Int
  fromClubId Int
  toClubId   Int?
  startDay   Int
  endDay     Int
  recalled   Boolean

  @@id([saveId, id])
}

model Competition {
  id                  Int
  saveId              Int
  save                Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  kind                String
  name                String
  round               Int
  stage               String
  // Multiplayer: a Competition with kind "division" represents one division of
  // the pyramid. These fields identify where in the pyramid it sits.
  seasonId            Int?
  season              MpSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  tier                Int    @default(1)
  groupIndex          Int    @default(0)
  referenceTimezone   String?
  status              String @default("ACTIVE")
  configJson          String
  winnersJson         String
  knockoutsJson       String
  groupStandingsJson  String

  @@id([saveId, id])
  @@index([saveId])
  @@index([saveId, seasonId, tier])
  @@unique([saveId, seasonId, tier, groupIndex])
}

model StandingsRow {
  id            Int     @id @default(autoincrement())
  saveId        Int
  save          Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  competitionId Int
  clubId        Int
  played        Int
  wins          Int
  draws         Int
  losses        Int
  goalsFor      Int
  goalsAgainst  Int
  points        Int
  groupName     String?

  @@index([saveId, competitionId])
}

model Fixture {
  id            Int
  saveId        Int
  save          Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  competitionId Int
  round         Int
  homeClubId    Int
  awayClubId    Int
  dayIndex      Int
  played        Boolean
  leg           Int?
  tie           Int?
  // Multiplayer: real kickoff timestamp (epoch ms). Null for legacy rows.
  kickoffAt     BigInt?
  homeClubNameSnapshot String?
  awayClubNameSnapshot String?

  @@id([saveId, id])
  @@index([saveId, competitionId])
}

model Match {
  id               Int
  saveId           Int
  save             Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  fixtureId        Int
  competitionId    Int
  homeClubId       Int
  awayClubId       Int
  homeScore        Int
  awayScore        Int
  penaltyWinnerId  Int?
  penaltyScoreJson String?
  attendance       Int
  gateRevenue      Int
  extraTime        Boolean

  @@id([saveId, id])
  @@index([saveId])
  @@unique([saveId, fixtureId])
}

model MatchStat {
  id              Int    @id @default(autoincrement())
  saveId          Int
  save            Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  matchId         Int
  homePossession  Int
  awayPossession  Int
  homeShots       Int
  awayShots       Int
  homeOnGoal      Int
  awayOnGoal      Int
  homeOffTarget   Int
  awayOffTarget   Int
  homeFouls       Int
  awayFouls       Int
  homeCorners     Int
  awayCorners     Int
  homeYellows     Int
  awayYellows     Int
  homeReds        Int
  awayReds        Int
  homeTackles     Int
  awayTackles     Int
  homeWrongPasses Int
  awayWrongPasses Int

  @@unique([saveId, matchId])
}

model MatchEvent {
  id        Int    @id @default(autoincrement())
  saveId    Int
  save      Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  matchId   Int
  minute    Int
  half      Int
  type      Int
  subtype   Int
  clubId    Int
  playerId  Int?
  player2Id Int?
  goalType  Int
  ordinal   Int

  @@index([saveId, matchId])
}

model NewsItem {
  id       Int    @id @default(autoincrement())
  saveId   Int
  save     Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  dayIndex Int
  text     String
  kind     String
  clubId   Int?
}

model LedgerEntry {
  id        Int    @id @default(autoincrement())
  saveId    Int
  save      Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId    Int
  direction String
  code      Int
  amount    Int
  day       Int
  label     String

  @@index([saveId, clubId])
}

model Auction {
  id           Int
  saveId       Int
  save         Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  playerId     Int
  minBid       Int
  deadlineDay  Int
  // Multiplayer: absolute epoch-ms deadline (plan §51). Null for legacy rows.
  startsAt     BigInt?
  endsAt       BigInt?
  sellerClubId Int?

  @@id([saveId, id])
  @@index([saveId, endsAt])
}

model AuctionBid {
  id        Int    @id @default(autoincrement())
  saveId    Int
  save      Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  auctionId Int
  clubId    Int
  amount    Int

  @@index([saveId, auctionId])
  @@unique([saveId, auctionId, clubId])
}

model Trophy {
  id              Int    @id @default(autoincrement())
  saveId          Int
  save            Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId          Int
  competitionName String
  count           Int

  @@index([saveId, clubId])
}

model ManagerHistory {
  id           Int     @id @default(autoincrement())
  saveId       Int
  save         Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId       Int
  name         String
  appointedDay Int
  departedDay  Int?
  gamesInCharge Int
  reason       String?
}

model SeasonAward {
  id                  Int    @id @default(autoincrement())
  saveId              Int
  save                Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  season              Int
  category            String
  competitionId       Int?
  playerId            Int?
  clubId              Int?
  playerNameSnapshot  String?
  detail              String?
}

model CareerRecord {
  id         Int    @id @default(autoincrement())
  saveId     Int
  save       Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  category   String
  value      Int
  holderName String
}

model ClubTicketPrices {
  id       Int    @id @default(autoincrement())
  saveId   Int
  save     Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId   Int
  sector0  Int
  sector1  Int
  sector2  Int
  sector3  Int

  @@unique([saveId, clubId])
}

model StadiumUpgrade {
  id            Int     @id @default(autoincrement())
  saveId        Int
  save          Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId        Int
  startedDay    Int
  completesDay  Int
  newCapacity   Int
  cost          Int
  completed     Boolean @default(false)

  @@index([saveId, clubId])
}

model TvDeal {
  id            Int  @id @default(autoincrement())
  saveId        Int
  save          Save @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId        Int
  season        Int
  baseAmount    Int
  positionBonus Int

  @@index([saveId, clubId])
}

model LiveMatch {
  saveId    Int
  save      Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  // Multiplayer: multiple live matches can run concurrently. The runtime key
  // is the match's id (the engine's Match id for the live fixture).
  matchId   Int
  stateJson String

  @@id([saveId, matchId])
}

// ---------------------------------------------------------------------------
// Multiplayer league system
// ---------------------------------------------------------------------------

// One synchronized season = one calendar month. All divisions share the same
// global season. See plans/multiplayer.md.
model MpSeason {
  id                 Int      @id @default(autoincrement())
  year               Int
  month              Int
  startsAt           DateTime
  endsAt             DateTime
  // Round after which no new humans may join the current season.
  joinLockRound      Int
  joinThresholdPercent Float
  // PREPARATION | ACTIVE | INTERSEASON | ROLLOVER | COMPLETE
  status             String   @default("ACTIVE")
  completedRounds    Int      @default(0)
  // OPEN | LOCKED — the authoritative join gate (set transactionally).
  joinState          String   @default("OPEN")
  createdAt          DateTime @default(now())

  divisions          Competition[]
  clubSeasons        MpClubSeason[]
  allocations        MpAllocation[]

  @@unique([year, month])
}

// Per-division membership for a season. Memberships are disposable between
// seasons; tiers are the persistent competitive level.
model MpMembership {
  id           Int      @id @default(autoincrement())
  divisionId   Int
  clubId       Int
  slotNumber   Int
  isFillerAI   Boolean  @default(false)
  replacedClubId Int?
  joinedAt     DateTime @default(now())

  @@unique([divisionId, clubId])
  @@unique([divisionId, slotNumber])
  @@index([divisionId])
}

// Per-club-per-season competition record. Standings live in StandingsRow
// (keyed by competition/division id); this row tracks eligibility + movement.
model MpClubSeason {
  id               Int      @id @default(autoincrement())
  clubId           Int
  seasonId         Int
  season           MpSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  divisionId       Int?
  tier             Int      @default(1)
  played           Int      @default(0)
  wins             Int      @default(0)
  draws            Int      @default(0)
  losses           Int      @default(0)
  goalsFor         Int      @default(0)
  goalsAgainst     Int      @default(0)
  points           Int      @default(0)
  promotionStatus  String   @default("NONE")
  relegationStatus String   @default("NONE")

  @@unique([clubId, seasonId])
  @@index([seasonId])
}

// Clubs waiting for the next season (post join-lock joins, returning dormant
// clubs). Queue ordering is by queuedAt ascending.
model MpQueue {
  id                 Int      @id @default(autoincrement())
  clubId             Int      @unique
  queuedAt           DateTime @default(now())
  // NEW_CLUB | RETURNING_CLUB
  source             String
  preferredSeasonId  Int
}

// Idempotent per-club-per-season economic allocations. The unique constraint
// prevents double-payment across retries / race conditions.
model MpAllocation {
  id       Int      @id @default(autoincrement())
  clubId   Int
  seasonId Int
  season   MpSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  // ACTIVE_FULL | ACTIVE_PRORATED | PROVISIONAL_NEXT_SEASON
  type     String
  amount   Int
  issuedAt DateTime @default(now())

  @@unique([clubId, seasonId, type])
  @@index([seasonId])
}

// Audit trail of meaningful activity used for abandonment detection.
model MpActivity {
  id           Int      @id @default(autoincrement())
  userId       Int
  clubId       Int
  activityType String
  occurredAt   DateTime @default(now())
  metadata     String?

  @@index([clubId, occurredAt])
  @@index([userId, occurredAt])
}

// Structured audit trail for disputes and operational diagnosis. Unlike
// MpActivity (which is user activity for abandonment), this records league
// state transitions and worker decisions.
model MpAudit {
  id          Int      @id @default(autoincrement())
  seasonId    Int?
  clubId      Int?
  userId      Int?
  eventType   String
  occurredAt  DateTime @default(now())
  metadata    String?

  @@index([seasonId, occurredAt])
  @@index([clubId, occurredAt])
}

// Simple key/value store for admin-tunable multiplayer settings
// (e.g. FIRST_DIVISION_SEASON_BUDGET, MINIMUM_TIER_BUDGET_RATIO,
// TIER_BUDGET_DECAY_RATE, JOIN_THRESHOLD_PERCENT).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Idempotency ledger for recurring worker jobs (plan §5 of the worker plan).
// A row exists once a scheduled job has run for a given (seasonId, date,
// executionType). The unique constraint makes duplicate execution impossible
// even across concurrent processes / crash-retry cycles.
model DailyExecution {
  id            Int      @id @default(autoincrement())
  saveId        Int
  save          Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  seasonId      Int
  date          String // YYYY-MM-DD (UTC)
  executionType String // DAILY_TICK | PAYROLL | WEEKLY | INACTIVITY | NOTIFICATIONS | ...
  executedAt    DateTime @default(now())

  @@unique([saveId, seasonId, date, executionType])
  @@index([saveId, date])
}
