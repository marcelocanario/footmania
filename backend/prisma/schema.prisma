generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Account identity lives in better-auth's User/Session/Account/Verification
// tables (see backend/src/auth.ts). The email is the verified account key:
// OAuth providers (Google today, Facebook later) link to the same user by
// verified email, so one person always maps to one User row. The in-game
// manager is called by their `name` (the Google display name) as the club's
// coachName.
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  emailVerified Boolean @default(false)
  image        String?
  timezone     String?
  isAdmin      Boolean  @default(false)
  isPro        Boolean  @default(false)
  bannedAt     DateTime?
  banReason    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  accounts     Account[]
  saves        Save[]
  club         Club?    @relation("ClubOwner")
  friendshipsA Friendship[] @relation("FriendshipA")
  friendshipsB Friendship[] @relation("FriendshipB")
  invitations  Invitation[]
  warnings     Warning[]
  notifications UserNotification[]
  pushSubscriptions PushSubscription[]
  clubIdentityArchive ClubIdentityArchive?
}

// better-auth session (token is a unique column, not the PK).
model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One authentication method linked to a user. The unique (issuer, accountId)
// pair is the provider-side identity; Google uses its issuer, other OAuth
// providers without one use the `local:oauth:<providerId>` namespace. Credential
// (email/password) accounts use `local:credential` and are not used by this game.
model Account {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer             String
  accountId          String
  providerId         String
  accessToken        String?
  refreshToken       String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope              String?
  idToken            String?
  password           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

// better-auth email/session verification records (e.g. OAuth state nonces).
model Verification {
  id          Int      @id @default(autoincrement())
  identifier  String
  value       String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([identifier])
}

// A save is fully normalized: every world entity lives in its own table.
// The in-memory `World` object stays the engine's source of truth; persistence
// is a full sync (delete + insert) inside the save lock, and loading rebuilds
// the World from the tables. `LiveMatch` is the documented exception: transient
// runtime state kept as JSON because it is never queried relationally.
model Save {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  year        Int
  dayIndex    Int
  humanClubId Int?
  seed        Int      @default(0)
  rngState    BigInt   @default(0)
  // Multiplayer: exactly one global Save row exists (isGlobal = true). It holds
  // the shared world all users play in. Regular per-user saves are retired.
  isGlobal    Boolean  @default(false)
  // Nullable so legacy per-user saves can coexist; GLOBAL is reserved for the
  // singleton multiplayer world and is database-unique.
  globalKey   String?  @unique
  // Optimistic concurrency: bumped on every persist; conditional updates use
  // it to detect lost updates when multiple processes write the global world.
  revision    Int      @default(0)
  // Position-model version: 1 = legacy numeric GK/FB/CB/MF/FW with Player.side
  // and Player.tacPos; 2 = nine natural positions, no side/tacPos (§14.1).
  // The default is 1 so every pre-existing row is correctly marked legacy and
  // the application migration actually runs; new worlds write 2 explicitly in
  // ensureGlobalSave. Startup refuses to load below 2.
  positionModelVersion Int @default(1)
  // Multiplayer runtime state (current season id, join state, etc.) persisted
  // as JSON so it survives reloads. Mirrors World.mp.
  mpStateJson String?
  seasonSummaryJson  String?
  // Final standings snapshots for completed seasons (plan §70). JSON because
  // history is write-once and never queried relationally.
  seasonHistoryJson String?
  pendingEventsJson  String?
  pendingMatchIdsJson String?
  // Player-generation idempotency ledger (academy intake, club creation).
  generationEventsJson String?
  // Financial-intervention audit records (financial-control §53). JSON because
  // they are write-once audit data and never queried relationally.
  financialInterventionsJson String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clubs          Club[]
  players        Player[]
  loans          Loan[]
  competitions   Competition[]
  standingsRows  StandingsRow[]
  fixtures       Fixture[]
  matches        Match[]
  clubEloEvents  ClubEloEvent[]
  matchStats     MatchStat[]
  matchEvents    MatchEvent[]
  newsItems      NewsItem[]
  ledgerEntries  LedgerEntry[]
  trophies       Trophy[]
  seasonAwards   SeasonAward[]
  records        CareerRecord[]
  liveMatches    LiveMatch[]
  dailyExecutions DailyExecution[]
  transferAuctions TransferAuction[]
  marketBids     MarketBid[]
  freeAgentListings FreeAgentListing[]
  marketReservations MarketReservation[]
  playerMarketTransactions PlayerMarketTransaction[]
  playerSeasonHistories PlayerSeasonHistory[]
  playerMatchRatings PlayerMatchRating[]
  roleCalibrations RoleCalibration[]
  gameClock       GameClock?
  scheduledEvents ScheduledEvent[]
  schedulerAudits AdminSchedulerAudit[]
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userAId   Int
  userBId   Int
  userA     User     @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Invitation {
  token         String    @id
  inviterUserId Int
  inviteeUserId Int?
  inviter       User      @relation(fields: [inviterUserId], references: [id], onDelete: Cascade)
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([inviterUserId])
}

// Persistent authoritative clock for the global world.
model GameClock {
  id              String   @id
  saveId          Int      @unique
  save            Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  absoluteGameDay Int
  seasonId        Int
  seasonNumber    Int
  seasonDayIndex  Int
  phase           String
  lastAdvancedAt  DateTime
  version         Int      @default(0)
}

model ScheduledEvent {
  id                    String   @id @default(uuid())
  saveId                Int
  save                  Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  type                  String
  timeBasis             String
  dueAbsoluteGameDay    Int?
  dueAt                 DateTime?
  phase                 String?
  priority              Int
  entityType            String?
  entityId              String?
  payloadJson           String   @default("{}")
  idempotencyKey        String   @unique
  status                String   @default("PENDING")
  attempts              Int      @default(0)
  maxAttempts           Int      @default(3)
  createdAt             DateTime @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  lastError             String?
  executionSource       String   @default("AUTOMATIC")
  executedByAdminUserId Int?
  version               Int      @default(0)

  @@index([saveId, status, timeBasis, dueAbsoluteGameDay])
  @@index([saveId, status, timeBasis, dueAt])
  @@index([entityType, entityId])
  @@index([saveId, type, entityType, entityId])
}

model AdminSchedulerAudit {
  id          String   @id @default(uuid())
  saveId      Int
  save        Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  adminUserId Int
  action      String
  targetType  String
  targetId    String?
  beforeJson  String
  afterJson   String
  reason      String?
  createdAt   DateTime @default(now())

  @@index([saveId, createdAt])
  @@index([adminUserId, createdAt])
}

model Club {
  id               Int
  saveId           Int
  save             Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  // Multiplayer: the user who owns this club, null for filler AI clubs.
  ownerUserId      Int?   @unique
  ownerUser        User?  @relation("ClubOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Multiplayer: IANA timezone of the owner (clustering target).
  timezone         String?
  // Multiplayer: NEW | PROVISIONAL | ACTIVE | DORMANT
  competitionState String @default("ACTIVE")
  // Multiplayer: epoch ms of the last meaningful activity.
  lastMeaningfulActivityAt BigInt?
  // Multiplayer: epoch ms when the club became abandonment-eligible (inactivity
  // threshold exceeded). Removal only happens at season rollover.
  abandonmentEligibleAt BigInt?
  // Multiplayer: real timestamp (epoch ms) of the human's live league match
  // kickoff. Null when the club has no upcoming live match. Once the scheduled
  // kickoff passes, the match auto-plays to completion.
  liveMatchAt      BigInt?
  // Preferred match-time windows as a JSON array of half-hour slot indices
  // (0 = 00:00–00:30 UTC, 47 = 23:30–24:00). Null = unconstrained (legacy
  // humans and all AI clubs); consulted at fixture generation AND at season
  // regrouping (window-overlap clustering). Clients convert from/to the
  // browser's timezone; the server is pure UTC (see plans/9).
  preferredHoursJson String?
  // Friend-grouping consent (bilateral rule): when true, this owner's accepted
  // friendships may pull them into the same division group at rollover
  // regrouping. A pair only influences grouping when BOTH sides opted in;
  // legacy rows default to true via the column default.
  friendGroupingOptIn Boolean @default(true)
  name             String
  shortName        String
  country          String
  // Highest division this club has ever reached (1 = strongest). Historical
  // milestone, updated only once the club actually enters a higher division.
  highestDivision  Int      @default(1)
  cash             Int
  stadiumName      String
  primaryColor     String
  secondaryColor   String
  // Kit Lab: JSON-encoded {home,away,gk} jersey designs (game/kits.ts).
  // Null = derive designs from the two identity colors.
  kitJson          String?
  // Crest/logo customization: single SVG variant recolored from team colors
  // for everyone; custom raster upload for Pro members.
  logoVariant      Int      @default(0)
  customLogoMime   String?
  customLogoData   String?
  customLogoStatus String   @default("ACTIVE")
  // Automation presets (JSON array of presets, each tied to a formation).
  automationPresetsJson String?
  coachName        String
  coachNameChangedSeasonKey String?
  isHuman          Boolean
  captainId        Int?
  penaltyTakerId   Int?
  tacticsFormation Int
  tacticsStyle     Int
  tacticsPressing  Int
  tacticsDirection Int
  // Per-setup tactical familiarity progress (plans/6 §17): JSON map keyed by
  // "formation-style-pressing-direction" -> {familiarity,lastUsedAbsoluteGameDay}.
  // Null = never tracked; reads fall back to the neutral INITIAL_FAMILIARITY.
  tacticsFamiliarityJson String?
  trainingFocus   String @default("assistant")
  savedLineupJson  String?
  eloRating        Float    @default(1500)
  eloRatedMatches  Int      @default(0)

  @@id([saveId, id])
  @@index([saveId, ownerUserId])
  @@unique([saveId, ownerUserId])
}

model Player {
  id              Int
  saveId          Int
  save            Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId          Int?
  name            String
  country         String
  age             Int
  position        Int
  overall         Int
  energy          Int
  recentLoad      Float    @default(0)
  salary          Int
  payrollPaidThroughDay Int @default(0)
  payrollPaidAmount Int @default(0)
  payrollPeriodStartDay Int @default(0)
  value           Int
  releaseClause   Int
  injuryDays      Int
  injuryUntilAbsoluteGameDay Int?
  injuryInitialGameDays Int?
  injuryEquivalentRealDays Float?
  injuryCause     String?
  contractDays    Int
  isYouth         Boolean
  starter         Boolean
  // OVR-equivalent growth/decline already realized out of the player's career
  // budgets. Bookkeeping only: it records what was spent, never extra capacity.
  careerGrowthConsumed  Float
  careerDeclineConsumed Float
  careerGoals     Int
  careerAssists   Int
  seasonGoals     Int
  seasonAssists   Int
  // Matches in which the player was named MVP (best performer on the winning
  // team). careerMvps is a lifetime counter; seasonMvps resets at season
  // rollover like the other season counters.
  careerMvps      Int      @default(0)
  seasonMvps      Int      @default(0)
  // League matches this season with at least one minute on the pitch.
  seasonAppearances Int @default(0)
  yellows         Int
  reds            Int
  // Squad shirt number; unique within a club. Null = not yet assigned.
  squadNumber     Int?
  onSale          Boolean
  suspendedGames  Int
  // Yellow cards accumulated within the current league turn, plus the stable
  // key of that turn (seasonNumber * league.turns + floor(round/(teams-1))).
  // Null = no bookings recorded in any turn. Reaching
  // gameConfig.discipline.turnYellowLimit within one turn triggers a ban.
  turnYellows     Int
  yellowsTurnKey  Int?
  loanId          Int?
  skillGol        Int
  skillPace       Int
  skillTec        Int
  skillPas        Int
  skillDes        Int
  skillPlaymaking Int
  skillFin        Int
  nickname        String?
  skillAccJson    String
  // The five hidden career-shape attributes. Potential sets total magnitude,
  // speed only changes timing, peakAge is where growth ends and decline begins.
  growthPotential  Float
  growthSpeed      Float
  peakAge          Int
  declinePotential Float
  declineSpeed     Float
  recentMinutesJson String?
  // Immutable player-origin metadata (player-generation §50). Null for players
  // migrated from saves created before this generator landed.
  generatedClubId Int?
  generatedDivision Int?
  generatedSeasonId Int?
  generationType String?
  generatedClubHighestDivision Int?
  rawZ Float?
  // Season in which this player was generated as a financial-intervention
  // replacement (financial-control §31). Prevents repeated system-funded
  // liquidation within the same season.
  financialInterventionGeneratedSeasonId Int?

  @@id([saveId, id])
  @@index([saveId, clubId])
}

model Loan {
  id         Int
  saveId     Int
  save       Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  playerId   Int
  fromClubId Int
  toClubId   Int?
  startDay   Int
  endDay     Int
  recalled   Boolean
  // Lender-chosen claim fee (§55), snapshotted in absolute currency at listing
  // time. Paid by the borrower to the lender at claim; 0 for legacy rows.
  feeAmount  Int @default(0)
  // Multiplayer: real-time listing/claim window (§57) for the loan market.
  listedAt   BigInt
  claimableAt BigInt

  @@id([saveId, id])
  @@index([saveId, playerId])
}

model Competition {
  id                  Int
  saveId              Int
  save                Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  kind                String
  name                String
  round               Int
  stage               String
  // Multiplayer: a Competition with kind "division" represents one division of
  // the pyramid. These fields identify where in the pyramid it sits.
  seasonId            Int?
  season              MpSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  tier                Int    @default(1)
  groupIndex          Int    @default(0)
  referenceTimezone   String?
  status              String @default("ACTIVE")
  configJson          String
  winnersJson         String
  knockoutsJson       String
  groupStandingsJson  String

  @@id([saveId, id])
  @@index([saveId, seasonId, tier])
  @@unique([saveId, seasonId, tier, groupIndex])
}

model StandingsRow {
  id            Int     @id @default(autoincrement())
  saveId        Int
  save          Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  competitionId Int
  clubId        Int
  played        Int
  wins          Int
  draws         Int
  losses        Int
  goalsFor      Int
  goalsAgainst  Int
  points        Int
  groupName     String?

  @@index([saveId, competitionId])
}

model Fixture {
  id            Int
  saveId        Int
  save          Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  competitionId Int
  round         Int
  homeClubId    Int
  awayClubId    Int
  dayIndex      Int
  played        Boolean
  leg           Int?
  tie           Int?
  // Multiplayer: real kickoff timestamp (epoch ms). Null for legacy rows.
  kickoffAt     BigInt?
  scheduledSeasonDayIndex Int?
  homeClubNameSnapshot String?
  awayClubNameSnapshot String?

  @@id([saveId, id])
  @@index([saveId, competitionId])
  @@index([saveId, homeClubId])
  @@index([saveId, awayClubId])
}

model Match {
  id               Int
  saveId           Int
  save             Save    @relation(fields: [saveId], references: [id], onDelete: Cascade)
  fixtureId        Int
  competitionId    Int
  homeClubId       Int
  awayClubId       Int
  homeScore        Int
  awayScore        Int
  penaltyWinnerId  Int?
  penaltyScoreJson String?
  extraTime        Boolean
  scheduledAt      BigInt?
  homeWasHuman     Boolean  @default(false)
  awayWasHuman     Boolean  @default(false)
  eloProcessed     Boolean  @default(false)
  // Player named MVP of the match (computed at finalization; null = not set).
  mvpPlayerId      Int?

  @@id([saveId, id])
  @@index([saveId])
  @@unique([saveId, fixtureId])
}

model ClubEloEvent {
  id              Int      @id @default(autoincrement())
  saveId          Int
  save            Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  matchId         Int
  clubId          Int
  opponentClubId  Int
  ratingBefore    Float
  ratingAfter     Float
  delta           Float
  expectedScore   Float
  actualScore     Float
  createdAt       DateTime @default(now())

  @@unique([saveId, matchId, clubId])
  @@index([saveId, clubId, createdAt])
}

model MatchStat {
  id       Int    @id @default(autoincrement())
  saveId   Int
  save     Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  matchId  Int
  // Full per-team match stats (plans/6. §44) serialized as JSON: the shape
  // includes nested team objects and is not relational.
  statsJson String

  @@unique([saveId, matchId])
}

model MatchEvent {
  id        Int    @id @default(autoincrement())
  saveId    Int
  save      Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  matchId   Int
  minute    Int
  half      Int
  type      Int
  subtype   Int
  clubId    Int
  playerId  Int?
  player2Id Int?
  goalType  Int
  ordinal   Int

  @@index([saveId, matchId])
  @@index([saveId, playerId])
}

model NewsItem {
  id       Int    @id @default(autoincrement())
  saveId   Int
  save     Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  dayIndex Int
  text     String
  kind     String
  clubId   Int?
  // Inbox model (news overhaul): `subject` is the grouping key component so
  // same-day same-subject items for one recipient merge into a single message.
  // Null subject = never merges (legacy rows, MOTDs, one-off reports).
  seasonId        Int?
  subject         String?
  headline        String?
  entriesJson     String?
  // Privacy: when set, only that club's manager sees the item in snapshots.
  recipientClubId Int?

  @@index([saveId, id])
}

model LedgerEntry {
  id        Int    @id @default(autoincrement())
  saveId    Int
  save      Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId    Int
  direction String
  code      Int
  amount    Int
  day       Int
  label     String

  @@index([saveId, clubId])
}

model Trophy {
  id              Int    @id @default(autoincrement())
  saveId          Int
  save            Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId          Int
  competitionName String
  count           Int

  @@index([saveId, clubId])
}

model SeasonAward {
  id                  Int    @id @default(autoincrement())
  saveId              Int
  save                Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  season              Int
  category            String
  competitionId       Int?
  playerId            Int?
  clubId              Int?
  playerNameSnapshot  String?
  detail              String?

  @@index([saveId, season, id])
}

model CareerRecord {
  id         Int    @id @default(autoincrement())
  saveId     Int
  save       Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  category   String
  value      Int
  holderName String

  @@index([saveId, category])
}

model LiveMatch {
  saveId    Int
  save      Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  // Multiplayer: multiple live matches can run concurrently. The runtime key
  // is the match's id (the engine's Match id for the live fixture).
  matchId   Int
  homeClubId Int?
  awayClubId Int?
  stateJson String

  @@id([saveId, matchId])
  @@index([saveId, homeClubId])
  @@index([saveId, awayClubId])
}

// ---------------------------------------------------------------------------
// Multiplayer transfer market (Phase 2+)
// ---------------------------------------------------------------------------

// A public club-to-club auction listing (transfer-market-overhaul §9-§20).
model TransferAuction {
  id                    Int
  saveId                Int
  save                  Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  playerId              Int
  sellerClubId          Int
  playerValueAtListing  Int
  openingPrice          Int
  bidIncrement          Int
  // Division snapshots taken at listing time (cap basis, §10/§102.13.3).
  sellerDivisionAtListing Int
  totalDivisionsAtListing Int
  // Contract-demand baseline snapshots. Null is allowed for legacy rows.
  salaryBaselineAtListing Int?
  playerOverallAtListing Int?
  playerAgeAtListing     Int?
  currentPrice          Int
  leadingClubId         Int?
  createdAt             BigInt
  deadline              BigInt
  originalDeadline      BigInt
  status                String
  completedAt           BigInt?
  winningClubId         Int?
  finalPrice            Int?
  cancelledAt           BigInt?
  softClosed            Boolean
  deadlineVersion       Int      @default(0)

  @@id([saveId, id])
  @@index([saveId, status])
  @@index([saveId, deadline])
  @@index([saveId, playerId, status])
}

// A club's private maximum bid on a transfer or free-agent listing (§11/§69).
model MarketBid {
  id                            Int      @id @default(autoincrement())
  saveId                        Int
  save                          Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  marketType                    String // TRANSFER | FREE_AGENT
  listingId                     Int
  clubId                        Int
  maxBid                        Int
  capMultiplierAtSubmission     Float?
  maximumAllowedByRuleAtSubmission Int?
  buyerDivisionAtSubmission     Int?
  contractSeasons               Int?
  contractSalary                Int?
  contractDemandAtSubmission   Int?
  createdAt                     BigInt
  updatedAt                     BigInt
  initialPriorityAt             BigInt

  @@unique([saveId, marketType, listingId, clubId])
  @@index([saveId, marketType, listingId])
}

// A free-agent listing with a frozen salary baseline (§41-§54).
model FreeAgentListing {
  id                 Int
  saveId             Int
  save               Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  playerId           Int
  playerValueAtListing Int
  openingPrice       Int
  bidIncrement       Int
  salaryBaselineAtListing Int?
  currentPrice       Int
  leadingClubId      Int?
  relistStage        Int
  createdAt          BigInt
  deadline           BigInt
  status             String
  completedAt        BigInt?
  winningClubId      Int?
  finalPrice         Int?
  previousListingId  Int?
  // Former club forbidden from bidding on this specific listing after a
  // financial-intervention liquidation (financial-control §35/§36).
  blockedClubId      Int?
  unclaimedSince     BigInt?
  softClosed         Boolean

  @@id([saveId, id])
  @@index([saveId, status])
  @@index([saveId, deadline])
  @@index([saveId, playerId, status])
}

// Durable funds reserved against a club's active market commitments (§23).
model MarketReservation {
  id         Int    @id @default(autoincrement())
  saveId     Int
  save       Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  clubId     Int
  listingId  Int
  marketType String // TRANSFER | FREE_AGENT
  amount     Int
  createdAt  BigInt
  releasedAt BigInt?

  @@index([saveId, clubId])
  @@index([saveId, marketType, listingId])
}

// Completed market movement history (§72).
model PlayerMarketTransaction {
  id         Int      @id @default(autoincrement())
  saveId     Int
  save       Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  playerId   Int
  listingId  Int?
  type       String // TRANSFER | FREE_AGENT_SIGNING | LOAN
  fromClubId Int?
  toClubId   Int?
  price      Int
  seasonId   Int
  seasonKey  String
  // Nullable during the matchday -> seasonDayIndex data migration; the domain
  // loader supplies the legacy value until the next save rewrites the row.
  seasonDayIndex Int?
  matchday      Int?
  // Monotonic completed-rounds counter at transaction time (resale anchor
  // fade). Nullable for legacy rows written before the field existed.
  completedRounds Int?
  contractSeasons Int?
  contractSalary  Int?
  timestamp  BigInt

  @@index([saveId, playerId])
  @@index([saveId, playerId, timestamp])
}

// ---------------------------------------------------------------------------
// Multiplayer league system
// ---------------------------------------------------------------------------

// One synchronized season = one derived game-calendar cycle. Legacy year/month
// fields remain as display metadata for old saves only.
model MpSeason {
  id                 Int      @id @default(autoincrement())
  year               Int
  month              Int
  startsAt           DateTime
  endsAt             DateTime
  // Round after which no new humans may join the current season.
  joinLockRound      Int
  joinThresholdPercent Float
  // PREPARATION | ACTIVE | INTERSEASON | ROLLOVER | COMPLETE
  status             String   @default("ACTIVE")
  completedRounds    Int      @default(0)
  // OPEN | LOCKED — the authoritative join gate (set transactionally).
  joinState          String   @default("OPEN")
  createdAt          DateTime @default(now())
  seasonNumber       Int      @default(0)
  startAbsoluteGameDay Int    @default(0)
  endAbsoluteGameDay Int      @default(0)
  calendarVersion    Int      @default(1)

  divisions          Competition[]
  clubSeasons        MpClubSeason[]
  allocations        MpAllocation[]

  @@unique([year, month])
}

// Per-division membership for a season. Memberships are disposable between
// seasons; tiers are the persistent competitive level.
model MpMembership {
  id           Int      @id @default(autoincrement())
  divisionId   Int
  clubId       Int
  slotNumber   Int
  isFillerAI   Boolean  @default(false)
  replacedClubId Int?
  joinedAt     DateTime @default(now())

  @@unique([divisionId, clubId])
  @@unique([divisionId, slotNumber])
  @@index([divisionId])
}

// Per-club-per-season competition record. Standings live in StandingsRow
// (keyed by competition/division id); this row tracks eligibility + movement.
model MpClubSeason {
  id               Int      @id @default(autoincrement())
  clubId           Int
  seasonId         Int
  season           MpSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  divisionId       Int?
  tier             Int      @default(1)
  played           Int      @default(0)
  wins             Int      @default(0)
  draws            Int      @default(0)
  losses           Int      @default(0)
  goalsFor         Int      @default(0)
  goalsAgainst     Int      @default(0)
  points           Int      @default(0)
  promotionStatus  String   @default("NONE")
  relegationStatus String   @default("NONE")

  @@unique([clubId, seasonId])
  @@index([seasonId])
}

// Clubs waiting for the next season (post join-lock joins, returning dormant
// clubs). Queue ordering is by queuedAt ascending.
model MpQueue {
  id                 Int      @id @default(autoincrement())
  clubId             Int      @unique
  queuedAt           DateTime @default(now())
  // NEW_CLUB | RETURNING_CLUB
  source             String
  preferredSeasonId  Int
}

// Idempotent per-club-per-season economic allocations. The unique constraint
// prevents double-payment across retries / race conditions.
model MpAllocation {
  id       Int      @id @default(autoincrement())
  clubId   Int
  seasonId Int
  season   MpSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  // ACTIVE_FULL | ACTIVE_PRORATED | PROVISIONAL_NEXT_SEASON
  type     String
  amount   Int
  issuedAt DateTime @default(now())

  @@unique([clubId, seasonId, type])
  @@index([seasonId])
}

// Audit trail of meaningful activity used for abandonment detection.
model MpActivity {
  id           Int      @id @default(autoincrement())
  userId       Int
  clubId       Int
  activityType String
  occurredAt   DateTime @default(now())
  metadata     String?

  @@index([clubId, occurredAt])
  @@index([userId, occurredAt])
}

// Structured audit trail for disputes and operational diagnosis. Unlike
// MpActivity (which is user activity for abandonment), this records league
// state transitions and worker decisions.
model MpAudit {
  id          Int      @id @default(autoincrement())
  seasonId    Int?
  clubId      Int?
  userId      Int?
  eventType   String
  occurredAt  DateTime @default(now())
  metadata    String?

  @@index([seasonId, occurredAt])
  @@index([clubId, occurredAt])
}

// Simple key/value store for global operational settings: the global lock,
// scheduler bookkeeping, match timing, inactivity thresholds and the join
// threshold (e.g. JOIN_THRESHOLD_PERCENT, MATCH_TIME_MODE, INACTIVITY_TIER_1).
//
// Economy BALANCE parameters are deliberately not stored here. The season
// budget curve and the player-value model are owned by game.config.jsonc alone,
// so a configuration rollout can never be silently overridden by a stale row.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Global (not save-scoped) reference data: the per-country first-name and
// surname pools used by player/coach name generation. Previously loaded from
// backend/assets/namepools/*.txt at runtime; now the database is the source of
// truth and the rows are loaded once into an in-memory catalog at startup.
//
// `position` is the 0-based index within the country+kind pool and `value` the
// raw line. Duplicate lines are preserved (they weight the seeded RNG exactly
// like the original files) and rows are never de-duplicated or reordered.
// `backend/assets/namepools.json` is the committed seed artifact, populated by
// `npm run db:seed-name-pools`.
model NamePoolEntry {
  id          Int    @id @default(autoincrement())
  countryCode String
  kind        String // "names" | "surnames"
  position    Int
  value       String

  @@unique([countryCode, kind, position])
  @@index([countryCode, kind])
}

// Idempotency ledger for recurring worker jobs (plan §5 of the worker plan).
// A row exists once a scheduled job has run for a given (seasonId, date,
// executionType). The unique constraint makes duplicate execution impossible
// even across concurrent processes / crash-retry cycles.
model DailyExecution {
  id            Int      @id @default(autoincrement())
  saveId        Int
  save          Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  seasonId      Int
  date          String // YYYY-MM-DD (UTC)
  executionType String // DAILY_TICK | PAYROLL | WEEKLY | INACTIVITY | NOTIFICATIONS | ...
  executedAt    DateTime @default(now())

  @@unique([saveId, seasonId, date, executionType])
  @@index([saveId, date])
}

// Pro & moderation (cumulative permissions: admins have pro + admin)
model Warning {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason             String
  issuedByAdminUserId Int
  createdAt          DateTime @default(now())
  acknowledgedAt     DateTime?

  @@index([userId])
  @@index([userId, acknowledgedAt])
}

model UserNotification {
  id          String   @id @default(uuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  payloadJson String   @default("{}")
  dedupeKey   String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  readAt      DateTime?

  @@index([userId, createdAt])
  @@index([userId, occurredAt])
  @@index([userId, readAt])
  @@index([userId, readAt, occurredAt])
  @@unique([userId, dedupeKey])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([endpoint])
}

model PlayerSeasonHistory {
  id         Int      @id @default(autoincrement())
  saveId     Int
  save       Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  playerId   Int
  seasonId   Int
  seasonKey  String
  clubId     Int
  clubName   String
  appearances Int
  goals      Int
  assists    Int
  yellows    Int
  reds       Int
  minutes    Int
  // Season MVP count snapshot (matches named MVP that season).
  mvps       Int      @default(0)
  // End-of-season snapshot for the player-trend charts (evolution of overall
  // and market value across seasons). Nullable: rows predating this field have
  // no snapshot, and the world is reset on rollout so no backfill is needed.
  overall    Int?
  value      Int?
  createdAt  DateTime @default(now())

  @@unique([saveId, playerId, seasonId])
  @@index([saveId, playerId])
  @@index([saveId, seasonId])
}

// Player match performance ratings (plan §16). Save-scoped, written at match
// finalization from the live rating accumulator; match-time facts (club, tier,
// season) are frozen so transfers never rewrite history.
model PlayerMatchRating {
  id                Int      @id @default(autoincrement())
  saveId            Int
  save              Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  matchId           Int
  playerId          Int
  clubId            Int
  seasonId          Int

  tier              Int
  primaryRole       String
  minutesPlayed     Int

  rawImpact         Float
  rawVariance       Float
  rawZ              Float
  balancedZ         Float
  ratingExact       Float?

  shootingImpact    Float
  passingImpact     Float
  dribblingImpact   Float
  defendingImpact   Float
  goalkeepingImpact Float

  createdAt         DateTime @default(now())

  @@unique([saveId, matchId, playerId])
  @@index([saveId, playerId, createdAt])
  @@index([saveId, playerId, seasonId])
  @@index([saveId, seasonId, primaryRole])
}

// Season-frozen positional calibration snapshot (plan §10). One row per coarse
// role, holding the historical Z_raw distribution used for the
// empirical-percentile Gaussianization during that season.
model RoleCalibration {
  id                Int    @id @default(autoincrement())
  saveId            Int
  save              Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  seasonId          Int
  role              String
  zRawsJson         String

  @@unique([saveId, seasonId, role])
  @@index([saveId, seasonId])
}

// Club identity preserved across a world reset (not save-scoped, so it
// survives the Save delete+recreate). When an admin resets the world with
// identity preservation, every human club is snapshotted here; the user's next
// join re-applies the snapshot instead of the wizard payload and the row is
// consumed (deleted) on successful placement. Nothing game-progress related
// (squad, finances, trophies) is stored — identity only.
model ClubIdentityArchive {
  userId             Int      @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  shortName          String
  country            String
  stadiumName        String
  coachName          String
  kitJson            String?
  primaryColor       String
  secondaryColor     String
  logoVariant        Int      @default(0)
  customLogoMime     String?
  customLogoData     String?
  customLogoStatus   String?
  preferredHoursJson String?
  friendGroupingOptIn Boolean @default(true)
  createdAt          DateTime @default(now())
}
