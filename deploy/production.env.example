# Copy this file to /srv/apps/footmania/container/.env on the homelab.
# Keep the real file outside Git and restrict it to the deployment account.

NODE_ENV=production
PORT=18085
LOG_LEVEL=warn

# Use the dedicated production role and an isolated production schema. Do not
# use footmania_dev or schema=development for the live world.
DATABASE_URL="postgresql://footmania_prod:REPLACE_WITH_PRODUCTION_DB_PASSWORD@192.168.0.35:5432/footmania?schema=production"

# Generate a new, stable value for this deployment (for example with
# `openssl rand -base64 32`). Changing it logs out every existing session.
BETTER_AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Google OAuth Web client. Authorized origin:
#   https://footmania.app
# Authorized redirect URI:
#   https://footmania.app/api/auth/callback/google
PUBLIC_ORIGIN="https://footmania.app"
GOOGLE_CLIENT_ID="1063552332322-9hrjs761123167b1j60hekojbpt1lr6q.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# The verified Google email that receives admin rights. Leave unset only when
# intentionally running without an admin account.
ADMIN_EMAIL="REPLACE_WITH_ADMIN_EMAIL"

# Create a Cloudflare Tunnel with footmania.app -> http://127.0.0.1:8084 and
# paste its token here. This value is consumed by the Compose tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN="REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN"
